cmake_minimum_required(VERSION 3.28)
# Each invocation owns its source, build and cache. No shared cache is cleared.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(root "${WORK}/${id}")
file(MAKE_DIRECTORY "${root}/source")
file(WRITE "${root}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.28)
project(probe LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
add_library(owner STATIC)
target_sources(owner PUBLIC FILE_SET CXX_MODULES FILES owner.ccm)
add_executable(consumer main.cc)
target_link_libraries(consumer PRIVATE owner)
add_executable(ordinary ordinary.cc)
set_target_properties(ordinary PROPERTIES CXX_SCAN_FOR_MODULES OFF)
]=])
file(WRITE "${root}/source/owner.ccm" "module;\n#include \"value.h\"\nexport module probe;\nexport constexpr int answer=VALUE;\n")
file(WRITE "${root}/source/value.h" "#define VALUE 1\n")
file(WRITE "${root}/source/main.cc" "import probe;\nint main() { return answer; }\n")
file(WRITE "${root}/source/ordinary.cc" "int main() { return 7; }\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE inherited)
string(REGEX MATCHALL "(^|\n)SCCACHE_[A-Za-z0-9_]+=" keys "${inherited}")
foreach(key IN LISTS keys)
  string(STRIP "${key}" key)
  string(REGEX REPLACE "=$" "" key "${key}")
  unset(ENV{${key}})
endforeach()
# A unique Unix socket avoids port races on POSIX. Windows sccache uses TCP.
set(ENV{SCCACHE_DIR} "${root}/cache")
set(ENV{SCCACHE_DIRECT} false)
set(ENV{SCCACHE_GHA_ENABLED} false)
set(ENV{SCCACHE_IDLE_TIMEOUT} 5)
if(WIN32)
  string(RANDOM LENGTH 4 ALPHABET 0123456789 random_port)
  math(EXPR port "20000 + 1${random_port}")
  set(ENV{SCCACHE_SERVER_PORT} "${port}")
else()
  set(ENV{SCCACHE_SERVER_UDS} "/tmp/modcache-${id}.sock")
endif()
file(WRITE "${root}/config" "")
set(ENV{SCCACHE_CONF} "${root}/config")
set(ENV{SCCACHE_CACHED_CONF} "${root}/cached-config")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    execute_process(COMMAND "${SCCACHE}" --stop-server OUTPUT_QUIET ERROR_QUIET)
    message(FATAL_ERROR "Failed (${status}): ${ARGV}")
  endif()
endfunction()
function(stats field out)
  execute_process(COMMAND "${SCCACHE}" --show-stats --stats-format=json OUTPUT_VARIABLE json RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot read sccache statistics")
  endif()
  string(JSON counts GET "${json}" stats "${field}" counts)
  string(JSON size LENGTH "${counts}")
  set(total 0)
  if(size GREATER 0)
    math(EXPR last "${size}-1")
    foreach(index RANGE ${last})
      string(JSON key MEMBER "${counts}" ${index})
      string(JSON value GET "${counts}" "${key}")
      math(EXPR total "${total}+${value}")
    endforeach()
  endif()
  set(${out} ${total} PARENT_SCOPE)
endfunction()
function(check_answer name expected)
  if(WIN32)
    set(suffix .exe)
  endif()
  execute_process(COMMAND "${root}/build/${name}${suffix}" RESULT_VARIABLE answer)
  if(NOT answer EQUAL expected)
    execute_process(COMMAND "${SCCACHE}" --stop-server OUTPUT_QUIET ERROR_QUIET)
    message(FATAL_ERROR "${name}: expected ${expected}, got ${answer}")
  endif()
endfunction()
function(drop_object target)
  file(GLOB_RECURSE objects "${root}/build/CMakeFiles/${target}.dir/*.o" "${root}/build/CMakeFiles/${target}.dir/*.obj")
  list(LENGTH objects count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one ${target} object, got ${objects}")
  endif()
  file(REMOVE ${objects})
endfunction()
run("${SCCACHE}" --start-server)
run("${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/build" -G Ninja
  "-DCMAKE_MAKE_PROGRAM=${NINJA}" "-DCMAKE_CXX_COMPILER=${COMPILER}"
  "-DCMAKE_CXX_COMPILER_LAUNCHER=${LAUNCHER}" -DCMAKE_BUILD_TYPE=Release)
run("${CMAKE_COMMAND}" --build "${root}/build" --parallel)
check_answer(consumer 1)
stats(cache_hits before)
drop_object(owner)
drop_object(consumer)
run("${CMAKE_COMMAND}" --build "${root}/build" --parallel)
check_answer(consumer 1)
stats(cache_hits after)
math(EXPR hits "${after}-${before}")
set(expected_hits 2)
if(WIN32)
  set(expected_hits 1)
endif()
if(NOT hits EQUAL expected_hits)
  message(FATAL_ERROR "Expected ${expected_hits} module cache hits, got ${hits}")
endif()
if(NOT WIN32)
  stats(cache_misses before)
  file(WRITE "${root}/source/value.h" "// Same expanded tokens, different source locations.\n#define VALUE 1\n")
  run("${CMAKE_COMMAND}" --build "${root}/build" --parallel)
  check_answer(consumer 1)
  stats(cache_misses after)
  if(NOT after GREATER before)
    message(FATAL_ERROR "Source-only edit reused a stale BMI")
  endif()
endif()
file(WRITE "${root}/source/value.h" "#define VALUE 2\n")
run("${CMAKE_COMMAND}" --build "${root}/build" --parallel)
check_answer(consumer 2)
stats(cache_hits before)
drop_object(ordinary)
run("${CMAKE_COMMAND}" --build "${root}/build" --target ordinary)
stats(cache_hits after)
check_answer(ordinary 7)
run("${SCCACHE}" --stop-server)
if(NOT after GREATER before)
  message(FATAL_ERROR "Ordinary compilation did not hit the cache")
endif()
message(STATUS "Module reuse, source-location invalidation, changed imports and ordinary caching passed")
file(REMOVE_RECURSE "${root}")
